* text=auto eol=lf
*.bat text eol=crlf

# Generated metadata is reviewable on demand; keep source changes visible in PRs.
rUGP/evidence/photon/images/static-review-*/catalog.json linguist-generated=true

# These runtime-bound CSVs contain meaningful CRLF controls inside quoted
# fields.  Preserve their exact bytes; generic line-ending normalization would
# silently change dialogue data and invalidate the public manifest hashes.
rUGP/games/photonflowers/text-data/runtime/zh-Hans.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
rUGP/games/photonmelodies/text-data/runtime/zh-Hans.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
